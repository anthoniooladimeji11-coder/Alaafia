# ─── Àlááfìà API — environment ───────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres. CURRENTLY points at Ìyàwó's Supabase database — the `alaafia_access`
# table lives there. Use the same connection string Ìyàwó's backend uses.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Must match Ìyàwó's JWT_SECRET — the admin routes (GET /api/alaafia-access,
# PATCH /api/alaafia-access/:id) verify an Ìyàwó ADMIN token.
JWT_SECRET="same-value-as-iyawo-backend"

# Resend — transactional email (access-request notice, API-key delivery, rotation)
RESEND_API_KEY=""

# Email routing (optional — these are the current defaults)
ALAAFIA_ADMIN_EMAIL="anthoniooladimeji11@gmail.com"
ALAAFIA_FROM_EMAIL="onboarding@resend.dev"
ALAAFIA_ADMIN_URL="https://iyawo.org/alaafia-admin"
ALAAFIA_DOCS_URL="https://iyawo.org/alaafia"
ALAAFIA_API_URL="https://api.iyawo.org"

# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowed CORS origins (optional — sensible default in code)
CORS_ORIGINS="http://localhost:5173,https://iyawo.org,https://www.iyawo.org"
# If set, the server pings itself every 4 min to defeat free-tier cold starts
BACKEND_URL=""

# ─── Live causal pipeline (POST /api/alaafia/analyse) ────────
# Only works where the Python pipeline (agents/, utils/) AND its deps
# (pandas, the local LLMs) are installed. Defaults to the repo root.
PIPELINE_PATH=""
ALAAFIA_RESULTS_STORE=""
ALAAFIA_JOBS_STORE="/tmp/alaafia_jobs.json"
