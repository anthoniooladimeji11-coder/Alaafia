# level-4 settlements — large, rebuilt from the GRID3 extents zip
data/spine/geo_settlement.parquet
data/spine/geo_settlement_geom.parquet

.venv/
__pycache__/
*.pyc
.pytest_cache/

# explorer/ build products — regenerated by `python explorer/build_bundle.py`
explorer/build/
